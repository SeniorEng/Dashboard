{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "test": "vitest run",
    "db:push": "ALLOW_NON_EPHEMERAL_DB_WRITE=1 drizzle-kit push",
    "db:backup-dev": "bash scripts/backup-dev-db.sh",
    "db:reseed-dev": "bash scripts/reseed-dev-db.sh",
    "gen:openapi": "tsx script/gen-openapi.ts",
    "sync:github": "bash scripts/github-sync.sh push",
    "sync:check": "bash scripts/github-sync.sh check",
    "sync:doctor": "bash scripts/github-sync.sh doctor",
    "cleanup:test-data": "tsx server/scripts/cleanup-test-data.ts",
    "db:sweep-dev": "tsx server/scripts/sweep-dev-test-data.ts",
    "purge:junk-master-data": "tsx server/scripts/purge-junk-master-data.ts",
    "check:no-test-junk": "tsx scripts/check-no-test-junk.ts",
    "test:sweep-dbs": "tsx scripts/sweep-test-dbs.ts",
    "test:sweep-pdfs": "tsx scripts/sweep-nonprod-pdfs.ts",
    "test:unblock": "tsx scripts/sweep-test-dbs.ts --force",
    "test:restart-smoke": "EPHEMERAL_RESTART_SMOKE=1 vitest run tests/unit/ephemeral-db-restart-after-crash-smoke.test.ts --project unit",
    "test:verify-cache": "tsx scripts/verify-template-cache.ts",
    "test:verify-concurrent-cache": "tsx scripts/verify-concurrent-cache-build.ts",
    "test:verify-concurrent-clone": "tsx scripts/verify-concurrent-template-clone.ts",
    "budget:correct-km-drift": "tsx server/scripts/reconcile-km-drift.ts",
    "lint": "eslint client/src server shared tests scripts script --max-warnings 0",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "chromium:smoke": "tsx scripts/smoke-chromium.ts",
    "validate:erechnung": "tsx scripts/validate-erechnung.ts",
    "validate:erechnung:strict": "tsx scripts/validate-erechnung-strict.ts",
    "mutation": "node scripts/run-mutation.mjs",
    "audit:ci": "better-npm-audit audit --level high",
    "postinstall": "node scripts/normalize-lockfile.mjs"
  },
