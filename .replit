modules = [
  "nodejs-20",
  "web",
  "python-3.11",
  "java-graalvm22.3",
  "postgresql-16",
]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["chromium"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = [
  "sh",
  "-c",
  "node script/check-build.mjs && NODE_ENV=production node dist/index.cjs",
]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5050
externalPort = 3000

[[ports]]
localPort = 5051
externalPort = 3001

[[ports]]
localPort = 5079
externalPort = 3002

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "billing-cov"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-smoke"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development tsx server/index.ts"
waitForPort = 5000

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run lint"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/with-ephemeral-db.ts 5050 npx vitest run"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "billing-cov"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "COVERAGE_PORT=5079 npx tsx script/coverage-gate.ts billing"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "e2e-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/with-ephemeral-db.ts 5051 npm run test:e2e:smoke"

[workflows.workflow.metadata]
outputType = "console"

[agent]
mockupState = "FULLSTACK"
integrations = ["javascript_object_storage:2.0.0", "github:1.0.0"]

[userenv]

[userenv.development]
BUDGET_HARD_HOLDS = "1"

[userenv.shared]
SUPER_ADMIN_EMAIL = "alrikdegenkolb@seniorenengel-alltagsbegleitung.de"


[userenv.production]
BUDGET_HARD_HOLDS = "1"
APPROVED_CLEANUP_LEGACY_ALLOCATIONS = "true"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[objectStorage]
defaultBucketID = "replit-objstore-a173a466-82e8-48ad-ba73-76f740ac99ca"
