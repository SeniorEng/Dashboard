# Python-Bytecode. Entsteht, sobald jemand `.claude/hooks/bash-gate.py` als
# Modul importiert (z.B. beim Review) — gehoert nie ins Repo.
__pycache__/
*.pyc

# Pre-publish DB-Backups (siehe docs/pre-publish-backup-runbook.md)
tmp/db-backups/
# Lauf-Protokolle der Korrekturskripte. `cleanup-test-data.ts` schreibt dort
# NAMEN und E-MAILS aller echten Mitarbeiter und Kunden hinein — laeuft es
# gegen die Dev-Prod-Kopie, liegt eine PII-Datei in einem Pfad, den bis hierhin
# nichts ignoriert hat. Zwei solche Dateien sind in W5.2b versehentlich
# mitcommittet worden (aus einem Verhaltenstest gegen die Wegwerf-DB).
tmp/*.log
# DB-Dumps (auch Root-Level) — nie ins Repo (Task #1840)
*.dump
# Playwright artifacts
test-results/
playwright-report/

# Log des lokal gestarteten Test-App-Servers (CLAUDE.md → Integrationstests lokal)
server.log
# Arbeitsverzeichnis des Ephemeral-DB-Orchestrators (Server-Bundle + Worker-Logs)
.local/

# Stryker mutation testing (Task #770)
reports/
# ...but keep audit/dry-run documentation under docs/reports/ tracked (GoBD-Auditspur)
!docs/reports/
!docs/reports/**
# Throwaway Stryker sandbox copies of the whole codebase (Task #935):
# .stryker-tmp/ (default) plus the per-profile tempDirName overrides
# (.stryker-tmp-command / .stryker-tmp-vitest from stryker.*.conf.mjs).
.stryker-tmp*/

# Coverage-Gate-Artefakte (generiert via script/coverage-gate.ts)
coverage/
exports/

# Platform-regenerated social-preview screenshot (Task #1267).
# Served at runtime via /api/public/og-image from object storage (branding/opengraph.jpg);
# the static copy is regenerated byte-different per checkpoint and only caused merge conflicts.
client/public/opengraph.jpg

# Replit Design-canvas working directory (Task #1268).
# Platform-managed metadata/assets generated by the Design tool; not referenced by app
# source or the build, only a source of binary merge churn when tracked.
.canvas/
