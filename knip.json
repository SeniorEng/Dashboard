{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "tests/**/*.ts",
    "server/scripts/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "script/**/*.{ts,mjs}",
    "client/src/features/*/hooks/index.ts"
  ],
  "project": [
    "client/src/**/*.{ts,tsx}",
    "server/**/*.ts",
    "shared/**/*.ts"
  ],
  "ignore": [
    "client/src/components/ui/**",
    ".cache/**"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "c8",
    "@stryker-mutator/core",
    "@stryker-mutator/vitest-runner",
    "jszip"
  ],
  "ignoreExportsUsedInFile": true
}
